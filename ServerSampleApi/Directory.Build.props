<Project>
  <!-- Cấu hình chung cho mọi project trong solution.
       .NET 10 là bản LTS, được hỗ trợ tới 11/2028. Đổi phiên bản .NET chỉ cần sửa ở đây. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
