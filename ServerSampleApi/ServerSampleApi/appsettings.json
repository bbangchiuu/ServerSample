{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ServerSampleApi",
    "Audience": "ServerSampleUnity",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "RefreshTokens": {
    "CleanupIntervalHours": 24
  },
  "RateLimiting": {
    "LoginPermitLimit": 5,
    "LoginWindowSeconds": 60,
    "RegisterPermitLimit": 10,
    "RegisterWindowSeconds": 3600
  }
}
