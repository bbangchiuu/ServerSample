# MẪU file .env cho deploy/docker-compose.yml. File này ĐƯỢC commit; chỉ chứa giá trị mẫu.
#
# Cách dùng: chép thành ".env" (cùng thư mục), rồi thay MỌI giá trị bằng khoá thật, ngẫu nhiên, dài.
# File ".env" chứa khoá thật đã nằm trong .gitignore: KHÔNG BAO GIỜ commit nó.
#
# Tạo một khoá ngẫu nhiên (PowerShell, chạy được cả trên Windows PowerShell 5.1):
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# Hoặc trên Linux:
#   openssl rand -base64 48

# Mật khẩu PostgreSQL (user "game"). Chỉ đặt ĐÚNG MỘT LẦN trước lần chạy đầu tiên:
# PostgreSQL chỉ đọc biến này khi tạo database lần đầu; đổi sau đó phải đổi cả trong database.
POSTGRES_PASSWORD=change-me-postgres-password

# Khoá ký JWT, ít nhất 32 ký tự. Đổi khoá = mọi access token đang có hết hiệu lực (người chơi phải làm mới token).
JWT_SIGNING_KEY=change-me-jwt-signing-key-at-least-32-characters

# Khoá cho API quản trị ([RequireSystemKey], ví dụ POST /api/leaderboard/rebuild), ít nhất 32 ký tự.
SYSTEM_API_KEY=change-me-system-api-key-at-least-32-characters

# Cổng trên máy để mở API (mặc định 8080).
API_PORT=8080

# true: bật Swagger UI (/swagger). Mặc định false trên server thật.
SWAGGER_ENABLED=false
